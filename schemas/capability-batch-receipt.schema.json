{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitvan.dev/schemas/capability-batch-receipt/v1",
  "title": "GitVan Capability Batch Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject", "planHash", "targets", "closure", "stages", "observations", "byStanding", "standing", "complete", "hash"],
  "properties": {
    "schema": { "const": "https://gitvan.dev/schemas/capability-batch-receipt/v1" },
    "subject": { "type": "object", "additionalProperties": true },
    "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "targets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^gitvan\\." } },
    "closure": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^gitvan\\." } },
    "stages": {
      "type": "array",
      "items": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^gitvan\\." } }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "verifier", "ok", "standing", "startedAt", "finishedAt", "output", "error"],
        "properties": {
          "capability": { "type": "string", "pattern": "^gitvan\\." },
          "verifier": { "type": ["string", "null"] },
          "ok": { "type": "boolean" },
          "standing": { "enum": ["UNKNOWN", "PARTIAL_ALIVE", "ALIVE", "BLOCKED", "BUILD_BROKEN", "UNSUPPORTED"] },
          "startedAt": { "type": ["string", "null"] },
          "finishedAt": { "type": ["string", "null"] },
          "output": {},
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "byStanding": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "standing": { "enum": ["UNKNOWN", "PARTIAL_ALIVE", "ALIVE", "BLOCKED", "BUILD_BROKEN", "UNSUPPORTED"] },
    "complete": { "type": "boolean" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
