#!/usr/bin/env bash
#
# GitVan v3.2.0 — Post-Push Hook (Custom)
#
# This is a custom hook that runs after a successful push.
# Git doesn't natively provide this hook, but it can be called manually
# or integrated into workflows.
#
# Use cases:
# - Deployment triggering
# - Notification systems
# - Metrics collection
# - CI/CD pipeline initiation
# - Documentation updates
#
# Exit codes:
# - 0: Success
# - Non-zero: Error (doesn't affect push)
#

set -e

# Configuration
GITVAN_CLI="${GITVAN_CLI:-gitvan}"
HOOK_NAME="post-push"
VERBOSE="${GITVAN_VERBOSE:-0}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
log_info() {
  if [ "$VERBOSE" -eq 1 ]; then
    echo -e "${GREEN}[${HOOK_NAME}]${NC} $1"
  fi
}

log_warn() {
  echo -e "${YELLOW}[${HOOK_NAME}]${NC} $1" >&2
}

log_error() {
  echo -e "${RED}[${HOOK_NAME}]${NC} $1" >&2
}

# Get git information
get_git_info() {
  CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
  REMOTE_NAME=$(git config --get "branch.$CURRENT_BRANCH.remote" 2>/dev/null || echo "origin")
  REMOTE_URL=$(git config --get "remote.$REMOTE_NAME.url" 2>/dev/null || echo "unknown")

  log_info "Remote: $REMOTE_NAME ($REMOTE_URL)"
  log_info "Branch: $CURRENT_BRANCH"
}

# Main execution
main() {
  log_info "Post-push hook starting..."

  # Get git information
  get_git_info

  # Check if GitVan CLI is available
  if ! command -v "$GITVAN_CLI" &> /dev/null; then
    log_warn "GitVan CLI not found, skipping knowledge hook evaluation"
    exit 0
  fi

  # Capture post-push event and evaluate knowledge hooks
  log_info "Evaluating knowledge hooks..."

  # Create event data JSON
  EVENT_DATA=$(cat <<EOF
{
  "remoteName": "$REMOTE_NAME",
  "remoteUrl": "$REMOTE_URL",
  "branchName": "$CURRENT_BRANCH",
  "timestamp": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
)

  # Call GitVan CLI to handle the event
  if ! echo "$EVENT_DATA" | "$GITVAN_CLI" hooks handle-event "$HOOK_NAME" --stdin; then
    log_warn "Knowledge hook evaluation failed (non-fatal)"
  fi

  log_info "Post-push hook completed"
  exit 0
}

# Run main function
main "$@"
