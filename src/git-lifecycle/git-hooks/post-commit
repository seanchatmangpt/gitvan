#!/usr/bin/env bash
#
# GitVan v3.2.0 — Post-Commit Hook
#
# This hook is invoked by git-commit after a commit is successfully created.
# It cannot affect the outcome of the commit.
#
# Use cases:
# - Notification systems
# - CI/CD triggering
# - Documentation generation
# - Metrics collection
# - Knowledge graph updates
#
# Exit codes:
# - 0: Success
# - Non-zero: Error (doesn't affect commit)
#

set -e

# Configuration
GITVAN_CLI="${GITVAN_CLI:-gitvan}"
HOOK_NAME="post-commit"
VERBOSE="${GITVAN_VERBOSE:-0}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
log_info() {
  if [ "$VERBOSE" -eq 1 ]; then
    echo -e "${GREEN}[${HOOK_NAME}]${NC} $1"
  fi
}

log_warn() {
  echo -e "${YELLOW}[${HOOK_NAME}]${NC} $1" >&2
}

log_error() {
  echo -e "${RED}[${HOOK_NAME}]${NC} $1" >&2
}

# Get git information
get_git_info() {
  COMMIT_HASH=$(git rev-parse HEAD 2>/dev/null || echo "unknown")
  COMMIT_MESSAGE=$(git log -1 --pretty=%B 2>/dev/null || echo "unknown")
  CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
  FILES_CHANGED=$(git diff --name-only HEAD~1 HEAD 2>/dev/null | wc -l | tr -d ' ')
  LINES_ADDED=$(git diff --numstat HEAD~1 HEAD 2>/dev/null | awk '{add+=$1} END {print add}')
  LINES_DELETED=$(git diff --numstat HEAD~1 HEAD 2>/dev/null | awk '{del+=$2} END {print del}')

  log_info "Commit: $COMMIT_HASH"
  log_info "Branch: $CURRENT_BRANCH"
  log_info "Files changed: $FILES_CHANGED"
}

# Main execution
main() {
  log_info "Post-commit hook starting..."

  # Get git information
  get_git_info

  # Check if GitVan CLI is available
  if ! command -v "$GITVAN_CLI" &> /dev/null; then
    log_warn "GitVan CLI not found, skipping knowledge hook evaluation"
    exit 0
  fi

  # Capture post-commit event and evaluate knowledge hooks
  log_info "Evaluating knowledge hooks..."

  # Create event data JSON (escape commit message)
  ESCAPED_MESSAGE=$(echo "$COMMIT_MESSAGE" | jq -R -s '.')
  EVENT_DATA=$(cat <<EOF
{
  "commitHash": "$COMMIT_HASH",
  "commitMessage": $ESCAPED_MESSAGE,
  "branchName": "$CURRENT_BRANCH",
  "filesChanged": $FILES_CHANGED,
  "linesAdded": ${LINES_ADDED:-0},
  "linesDeleted": ${LINES_DELETED:-0},
  "timestamp": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
)

  # Call GitVan CLI to handle the event
  if ! echo "$EVENT_DATA" | "$GITVAN_CLI" hooks handle-event "$HOOK_NAME" --stdin; then
    log_warn "Knowledge hook evaluation failed (non-fatal)"
  fi

  log_info "Post-commit hook completed"
  exit 0
}

# Run main function
main "$@"
