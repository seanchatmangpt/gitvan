---
to: src/capabilities/generated/manifest.mjs
mode: overwrite
sparql: |
  PREFIX gv: <https://gitvan.dev/ontology/capability#>
  PREFIX dcterms: <http://purl.org/dc/terms/>
  SELECT ?capability ?title ?state ?verifier
         (GROUP_CONCAT(STR(?dependency); separator="|") AS ?dependencies)
  WHERE {
    ?capability a gv:Capability ;
      dcterms:title ?title ;
      gv:state ?state ;
      gv:verifier ?verifier .
    OPTIONAL { ?capability gv:dependsOn ?dependency . }
  }
  GROUP BY ?capability ?title ?state ?verifier
  ORDER BY ?capability
---
// GENERATED by ggen from ontology/gitvan-capabilities.ttl. Do not hand edit.
export const gitvanCapabilities = Object.freeze([
{% for row in rows %}  {
    id: "{{ row.capability | replace(from="https://gitvan.dev/capability/", to="gitvan.") | replace(from="-", to=".") }}",
    title: {{ row.title | json_encode() }},
    state: {{ row.state | json_encode() }},
    dependsOn: Object.freeze([{% if row.dependencies %}{% for dependency in row.dependencies | split(pat="|") %}"{{ dependency | replace(from="https://gitvan.dev/capability/", to="gitvan.") | replace(from="-", to=".") }}"{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}]),
    verifier: {{ row.verifier | json_encode() }},
    generatedBy: "ggen",
  },
{% endfor %}]);
