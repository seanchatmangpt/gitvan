{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitvan.dev/schemas/capability-claims/v1",
  "title": "GitVan Capability Claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "expectedSubject", "claims", "byStanding", "hash"],
  "properties": {
    "schema": { "const": "https://gitvan.dev/schemas/capability-claims/v1" },
    "expectedSubject": { "type": "object", "additionalProperties": true },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "declaredStanding", "standing", "receiptHash", "subject", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^gitvan\\." },
          "title": { "type": "string", "minLength": 1 },
          "declaredStanding": { "enum": ["UNKNOWN", "PARTIAL_ALIVE", "ALIVE", "BLOCKED", "BUILD_BROKEN", "UNSUPPORTED"] },
          "standing": { "enum": ["UNKNOWN", "PARTIAL_ALIVE", "ALIVE", "BLOCKED", "BUILD_BROKEN", "UNSUPPORTED"] },
          "receiptHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "subject": { "type": "object", "additionalProperties": true },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "byStanding": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
