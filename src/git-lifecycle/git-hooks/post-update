#!/usr/bin/env bash
#
# GitVan v3.2.0 — Post-Update Hook (Server-side)
#
# This server-side hook is invoked after all refs have been updated by git-receive-pack.
# It is typically used on the server side after a push operation.
#
# Arguments:
# - $@: List of refs that were updated (e.g., refs/heads/main refs/tags/v1.0)
#
# Use cases:
# - Update repository web interface
# - Send notifications about pushed changes
# - Trigger CI/CD pipelines
# - Update repository metadata
# - Archive old refs
#
# Exit codes:
# - 0: Success
# - Non-zero: Error (doesn't affect push)
#

set -e

# Configuration
GITVAN_CLI="${GITVAN_CLI:-gitvan}"
HOOK_NAME="post-update"
VERBOSE="${GITVAN_VERBOSE:-0}"

# Hook arguments (refs that were updated)
UPDATED_REFS=("$@")

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
log_info() {
  if [ "$VERBOSE" -eq 1 ]; then
    echo -e "${GREEN}[${HOOK_NAME}]${NC} $1"
  fi
}

log_warn() {
  echo -e "${YELLOW}[${HOOK_NAME}]${NC} $1" >&2
}

log_error() {
  echo -e "${RED}[${HOOK_NAME}]${NC} $1" >&2
}

# Get git information
get_git_info() {
  CURRENT_BRANCH=$(git symbolic-ref HEAD 2>/dev/null | sed 's,refs/heads/,,' || echo "unknown")

  log_info "Branch: $CURRENT_BRANCH"
  log_info "Updated ${#UPDATED_REFS[@]} ref(s)"
}

# Main execution
main() {
  log_info "Post-update hook starting..."

  # Get git information
  get_git_info

  # Check if GitVan CLI is available
  if ! command -v "$GITVAN_CLI" &> /dev/null; then
    log_warn "GitVan CLI not found, skipping knowledge hook evaluation"
    exit 0
  fi

  # Capture post-update event and evaluate knowledge hooks
  log_info "Evaluating knowledge hooks..."

  # Create JSON array of updated refs
  UPDATED_REFS_JSON=$(printf '%s\n' "${UPDATED_REFS[@]}" | jq -R . | jq -s .)

  # Create event data JSON
  EVENT_DATA=$(cat <<EOF
{
  "branchName": "$CURRENT_BRANCH",
  "updatedRefs": $UPDATED_REFS_JSON,
  "refsCount": ${#UPDATED_REFS[@]},
  "timestamp": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
)

  # Call GitVan CLI to handle the event
  if ! echo "$EVENT_DATA" | "$GITVAN_CLI" hooks handle-event "$HOOK_NAME" --stdin; then
    log_warn "Knowledge hook evaluation failed (non-fatal)"
  fi

  log_info "Post-update hook completed"
  exit 0
}

# Run main function
main "$@"
