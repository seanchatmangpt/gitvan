/**
 * GitVan Marketplace - Pack discovery and browsing with caching
 * Main orchestrator that coordinates detection, operations, formatting, and caching
 */

import { PackRegistry } from "./registry.mjs";
import { createLogger } from "../utils/logger.mjs";
import { MarketplaceCache } from "./marketplace-cache.mjs";
import { formatResults, sortResults } from "./marketplace-formatting.mjs";
import * as ops from "./marketplace-operations.mjs";

/**
 * Marketplace class - Main interface for pack discovery and browsing
 *
 * Coordinates between:
 * - Detection: Finding and categorizing packs
 * - Operations: Browse, inspect, quickstart, etc.
 * - Formatting: Result formatting and scoring
 * - Caching: Performance optimization
 */
export class Marketplace {
  constructor(options = {}) {
    this.options = options;
    this.logger = createLogger("pack:marketplace");
    this.registry = null; // Lazy initialization
    this.cache = new MarketplaceCache(options.cacheTimeout || 300000);
  }

  /**
   * Get or create registry instance (lazy loading)
   * @returns {PackRegistry} Registry instance
   */
  getRegistry() {
    if (!this.registry) {
      this.registry = new PackRegistry(this.options);
    }
    return this.registry;
  }

  /**
   * Browse packs with filtering, sorting, and pagination
   * @param {Object} options - Browse options (query, filters, sort, limit, page)
   * @returns {Promise<Object>} Formatted browse results with pagination
   */
  async browse(options = {}) {
    return ops.browse(options, this.cache, this.logger);
  }

  /**
   * Inspect a specific pack by ID
   * @param {string} packId - Pack identifier
   * @returns {Promise<Object>} Detailed pack information
   */
  async inspect(packId) {
    return ops.inspect(
      packId,
      this.getRegistry.bind(this),
      this.cache,
      this.logger
    );
  }

  /**
   * Format search results with pagination and metadata
   * @param {Array} results - Array of pack results
   * @param {Object} options - Formatting options
   * @returns {Object} Formatted results
   */
  formatResults(results, options) {
    return formatResults(results, options);
  }

  /**
   * Sort results based on criteria
   * @param {Array} results - Array of packs
   * @param {string} sortBy - Sort criteria
   * @param {string} query - Search query for relevance
   * @returns {Array} Sorted results
   */
  sortResults(results, sortBy, query) {
    return sortResults(results, sortBy, query);
  }

  /**
   * Get quickstart packs for a specific category
   * @param {string} category - Category identifier
   * @returns {Promise<Object>} Quickstart packs
   */
  async quickstart(category) {
    return ops.quickstart(category, this.cache, this.logger);
  }

  /**
   * Get all available categories
   * @returns {Promise<Object>} Categories list
   */
  async getCategories() {
    return ops.getCategories();
  }

  /**
   * Get featured packs
   * @returns {Promise<Object>} Featured packs
   */
  async getFeatured() {
    return ops.getFeatured(this.getRegistry.bind(this), this.cache);
  }

  /**
   * Get marketplace statistics
   * @returns {Promise<Object>} Marketplace stats
   */
  async getStats() {
    return ops.getStats(this.getRegistry.bind(this), this.cache);
  }

  /**
   * Clear cache
   */
  clearCache() {
    this.cache.clear();
  }

  /**
   * Get cache statistics
   * @returns {Object} Cache stats
   */
  getCacheStats() {
    return this.cache.getStats();
  }
}

// Re-export utilities for backward compatibility
export { detectPacks, categorizePacks, getQuickstartCategories } from "./marketplace-detection.mjs";
export { formatResults, sortResults, calculateRelevanceScore, formatPackInfo } from "./marketplace-formatting.mjs";
export { MarketplaceCache } from "./marketplace-cache.mjs";
