#!/usr/bin/env bash
#
# GitVan v3.2.0 — Commit Message Hook
#
# This hook is invoked by git-commit to validate the commit message.
# It is run after the user has edited the commit message but before
# the commit is created.
#
# Arguments:
# - $1: Path to commit message file
#
# Use cases:
# - Commit message format validation
# - Conventional commit enforcement
# - Issue tracker reference validation
# - Message length checks
# - Prohibited word detection
#
# Exit codes:
# - 0: Allow commit
# - 1: Block commit
#

set -e

# Configuration
GITVAN_CLI="${GITVAN_CLI:-gitvan}"
HOOK_NAME="commit-msg"
VERBOSE="${GITVAN_VERBOSE:-0}"

# Hook arguments
COMMIT_MSG_FILE="$1"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
log_info() {
  if [ "$VERBOSE" -eq 1 ]; then
    echo -e "${GREEN}[${HOOK_NAME}]${NC} $1"
  fi
}

log_warn() {
  echo -e "${YELLOW}[${HOOK_NAME}]${NC} $1" >&2
}

log_error() {
  echo -e "${RED}[${HOOK_NAME}]${NC} $1" >&2
}

# Get git information
get_git_info() {
  CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
  COMMIT_MESSAGE=$(cat "$COMMIT_MSG_FILE" 2>/dev/null || echo "")

  log_info "Branch: $CURRENT_BRANCH"
  log_info "Message length: ${#COMMIT_MESSAGE}"
}

# Main execution
main() {
  log_info "Commit-msg hook starting..."

  # Get git information
  get_git_info

  # Check if GitVan CLI is available
  if ! command -v "$GITVAN_CLI" &> /dev/null; then
    log_warn "GitVan CLI not found, skipping knowledge hook evaluation"
    exit 0
  fi

  # Capture commit-msg event and evaluate knowledge hooks
  log_info "Evaluating knowledge hooks..."

  # Create event data JSON
  ESCAPED_MESSAGE=$(echo "$COMMIT_MESSAGE" | jq -R -s '.')
  EVENT_DATA=$(cat <<EOF
{
  "branchName": "$CURRENT_BRANCH",
  "commitMessage": $ESCAPED_MESSAGE,
  "timestamp": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
)

  # Call GitVan CLI to handle the event
  if ! echo "$EVENT_DATA" | "$GITVAN_CLI" hooks handle-event "$HOOK_NAME" --stdin; then
    log_error "Knowledge hook evaluation failed - commit message validation did not pass"
    exit 1
  fi

  log_info "Commit-msg hook completed successfully"
  exit 0
}

# Run main function
main "$@"
