# Development files
.github/
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# Test files
tests/
test/
**/*.test.mjs
**/*.spec.mjs
**/*.test.js
**/*.spec.js
coverage/
.nyc_output/
test-results.json
vitest.*.config.mjs
vitest.config.mjs

# Documentation (keep README.md, LICENSE, CHANGELOG.md)
docs/
*.md
!README.md
!CHANGELOG.md

# Examples
examples/

# Build configuration
build.config.ts
tsconfig.json
.eslintrc*
eslint.config.mjs
.prettierrc*
.editorconfig

