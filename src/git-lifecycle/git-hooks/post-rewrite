#!/usr/bin/env bash
#
# GitVan v3.2.0 — Post-Rewrite Hook
#
# This hook is invoked when commits are rewritten by commands like git-rebase,
# git-commit --amend, or git-filter-branch.
#
# Arguments:
# - $1: Type of rewrite (rebase|amend)
#
# Standard input: Lines of the form:
# <old-sha1> <new-sha1>
#
# Use cases:
# - Notification of history changes
# - Tracking rebases and amends
# - Sync issues with tracking systems
# - Audit trail for rewrites
# - Metrics collection
#
# Exit codes:
# - 0: Success
# - Non-zero: Error (doesn't affect rewrite)
#

set -e

# Configuration
GITVAN_CLI="${GITVAN_CLI:-gitvan}"
HOOK_NAME="post-rewrite"
VERBOSE="${GITVAN_VERBOSE:-0}"

# Hook arguments
REWRITE_TYPE="${1:-unknown}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
log_info() {
  if [ "$VERBOSE" -eq 1 ]; then
    echo -e "${GREEN}[${HOOK_NAME}]${NC} $1"
  fi
}

log_warn() {
  echo -e "${YELLOW}[${HOOK_NAME}]${NC} $1" >&2
}

log_error() {
  echo -e "${RED}[${HOOK_NAME}]${NC} $1" >&2
}

# Get git information
get_git_info() {
  CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
  CURRENT_COMMIT=$(git rev-parse HEAD 2>/dev/null || echo "unknown")

  # Read rewritten commits from stdin
  REWRITTEN_COUNT=0
  while read -r old_sha new_sha; do
    if [ -n "$old_sha" ]; then
      REWRITTEN_COUNT=$((REWRITTEN_COUNT + 1))
    fi
  done

  log_info "Branch: $CURRENT_BRANCH"
  log_info "Type: $REWRITE_TYPE"
  log_info "Commits rewritten: $REWRITTEN_COUNT"
}

# Main execution
main() {
  log_info "Post-rewrite hook starting..."

  # Get git information
  get_git_info

  # Check if GitVan CLI is available
  if ! command -v "$GITVAN_CLI" &> /dev/null; then
    log_warn "GitVan CLI not found, skipping knowledge hook evaluation"
    exit 0
  fi

  # Capture post-rewrite event and evaluate knowledge hooks
  log_info "Evaluating knowledge hooks..."

  # Create event data JSON
  EVENT_DATA=$(cat <<EOF
{
  "branchName": "$CURRENT_BRANCH",
  "commitHash": "$CURRENT_COMMIT",
  "rewriteType": "$REWRITE_TYPE",
  "commitsRewritten": $REWRITTEN_COUNT,
  "timestamp": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
)

  # Call GitVan CLI to handle the event
  if ! echo "$EVENT_DATA" | "$GITVAN_CLI" hooks handle-event "$HOOK_NAME" --stdin; then
    log_warn "Knowledge hook evaluation failed (non-fatal)"
  fi

  log_info "Post-rewrite hook completed"
  exit 0
}

# Run main function
main "$@"
