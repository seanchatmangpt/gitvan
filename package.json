{
  "name": "my-awesome-project",
  "version": "1.0.0",
  "description": "Generated by GitVan",
  "author": "Test Author",
  "_comment_unrdf": "unrdf is provided via git submodule at vendor/unrdf, not npm",
  "scripts": {
    "postinstall": "git submodule update --init --recursive || echo 'Warning: Failed to initialize git submodules. Run: git submodule update --init --recursive'",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:submodule": "vitest tests/submodule-integration.test.mjs tests/unrdf-real-usage.test.mjs",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.{js,mjs,json}\" \"tests/**/*.{js,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,mjs,json}\" \"tests/**/*.{js,mjs,json}\"",
    "prebuild": "node -e \"const fs=require('fs');const path=require('path');const vendorPath=path.join(process.cwd(),'vendor/unrdf');if(!fs.existsSync(vendorPath)){console.error('\\n❌ ERROR: vendor/unrdf submodule not found!');console.error('Run: git submodule update --init --recursive\\n');process.exit(1)}\"",
    "build": "unbuild",
    "dev": "vitest --watch",
    "prepublishOnly": "npm run build && npm test",
    "setup-dev": "npm install && bash scripts/init-submodules.sh",
    "verify-deps": "node scripts/verify-submodule.mjs",
    "update:submodule": "bash scripts/update-unrdf.sh"
  },
  "dependencies": {
    "bree": "^9.0.0",
    "c12": "^3.3.3",
    "citty": "^0.1.6",
    "consola": "^3.4.2",
    "defu": "^6.1.4",
    "hookable": "^6.0.1",
    "isomorphic-git": "^1.36.1",
    "pathe": "^2.0.3",
    "unctx": "^2.5.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "unbuild": "^3.6.1",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "esbuild": "^0.27.2",
    "rollup": "^4.55.1",
    "vite": "^7.3.1",
    "unplugin": "^2.3.11"
  }
}
