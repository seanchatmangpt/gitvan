#!/usr/bin/env bash
#
# GitVan v3.2.0 — Pre-Commit Hook
#
# This hook is invoked by git-commit before the commit is created.
# It can prevent the commit from being created by exiting with a non-zero status.
#
# Use cases:
# - Lint checking
# - Code formatting validation
# - Test execution
# - Security scanning
# - Preventing commits to protected branches
#
# Exit codes:
# - 0: Allow commit to proceed
# - 1: Block commit
#

set -e

# Configuration
GITVAN_CLI="${GITVAN_CLI:-gitvan}"
HOOK_NAME="pre-commit"
VERBOSE="${GITVAN_VERBOSE:-0}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
log_info() {
  if [ "$VERBOSE" -eq 1 ]; then
    echo -e "${GREEN}[${HOOK_NAME}]${NC} $1"
  fi
}

log_warn() {
  echo -e "${YELLOW}[${HOOK_NAME}]${NC} $1" >&2
}

log_error() {
  echo -e "${RED}[${HOOK_NAME}]${NC} $1" >&2
}

# Get git information
get_git_info() {
  CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
  STAGED_FILES=$(git diff --cached --name-only 2>/dev/null || echo "")
  STAGED_COUNT=$(echo "$STAGED_FILES" | grep -v '^$' | wc -l | tr -d ' ')

  log_info "Branch: $CURRENT_BRANCH"
  log_info "Staged files: $STAGED_COUNT"
}

# Main execution
main() {
  log_info "Pre-commit hook starting..."

  # Get git information
  get_git_info

  # Check if GitVan CLI is available
  if ! command -v "$GITVAN_CLI" &> /dev/null; then
    log_warn "GitVan CLI not found, skipping knowledge hook evaluation"
    exit 0
  fi

  # Capture pre-commit event and evaluate knowledge hooks
  log_info "Evaluating knowledge hooks..."

  # Create event data JSON
  EVENT_DATA=$(cat <<EOF
{
  "branchName": "$CURRENT_BRANCH",
  "stagedFiles": $(echo "$STAGED_FILES" | jq -R -s 'split("\n") | map(select(length > 0))'),
  "filesChanged": $STAGED_COUNT,
  "timestamp": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
)

  # Call GitVan CLI to handle the event
  if ! echo "$EVENT_DATA" | "$GITVAN_CLI" hooks handle-event "$HOOK_NAME" --stdin; then
    log_error "Knowledge hook evaluation failed"
    exit 1
  fi

  log_info "Pre-commit hook completed successfully"
  exit 0
}

# Run main function
main "$@"
