pnpm-lock.yaml
yarn.lock
package-lock.json
.npmrc
.yarnrc

# Source files (we package dist/ instead)
src/

# Environment files
.env
.env.*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Cache directories
.cache/
.vitest/
.turbo/
node_modules/.cache/

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# Graph storage (development only)
graph/

# Hooks (development only)
hooks/

# Jobs (keep examples in packs/ but exclude root jobs/)
jobs/

