# NPM Configuration for GitVan

# Use strict peer dependencies - DISABLED for compatibility
strict-peer-dependencies=false
legacy-peer-deps=true

# Engine strict - DISABLED for Node.js 22 compatibility
engine-strict=false

# Save exact versions (not ranges) for better reproducibility
save-exact=false

# Package lock
package-lock=true

# Audit level - fail on high severity vulnerabilities
audit-level=high

# Progress indicator
progress=true

# Fund messages
fund=false

# Update notifier
update-notifier=false

# Logs directory
logs-dir=.npm/_logs

# Registry (default npm registry)
registry=https://registry.npmjs.org/

# Prefer offline when packages are cached
prefer-offline=true

# Cache verification
cache-verify=true
