---
to: src/capabilities/generated/manifest.mjs
mode: overwrite
sparql: |
  PREFIX gv: <https://gitvan.dev/ontology/capability#>
  PREFIX dcterms: <http://purl.org/dc/terms/>
  SELECT ?capability ?title ?state ?verifier WHERE {
    ?capability a gv:Capability ; dcterms:title ?title ; gv:state ?state ; gv:verifier ?verifier .
  } ORDER BY ?capability
---
// GENERATED by ggen from ontology/gitvan-capabilities.ttl. Do not hand edit.
export const gitvanCapabilities = Object.freeze([
{% for row in rows %}  {
    id: "{{ row.capability | replace(from="https://gitvan.dev/capability/", to="gitvan.") | replace(from="-", to=".") }}",
    title: {{ row.title | json_encode() }},
    state: {{ row.state | json_encode() }},
    verifier: {{ row.verifier | json_encode() }},
    generatedBy: "ggen",
  },
{% endfor %}]);
