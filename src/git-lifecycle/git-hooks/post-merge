#!/usr/bin/env bash
#
# GitVan v3.2.0 — Post-Merge Hook
#
# This hook is invoked by git-merge after a merge has been completed.
# It is also invoked after git-pull when the pull is a merge.
#
# Arguments:
# - $1: Flag indicating whether the merge was a squash merge (1 = squash, 0 = normal)
#
# Use cases:
# - Dependency updates after merge
# - Build artifact cleanup
# - Database migrations
# - Conflict resolution notifications
# - Merge metrics collection
#
# Exit codes:
# - 0: Success
# - Non-zero: Error (doesn't affect merge)
#

set -e

# Configuration
GITVAN_CLI="${GITVAN_CLI:-gitvan}"
HOOK_NAME="post-merge"
VERBOSE="${GITVAN_VERBOSE:-0}"

# Hook arguments
SQUASH_MERGE="${1:-0}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
log_info() {
  if [ "$VERBOSE" -eq 1 ]; then
    echo -e "${GREEN}[${HOOK_NAME}]${NC} $1"
  fi
}

log_warn() {
  echo -e "${YELLOW}[${HOOK_NAME}]${NC} $1" >&2
}

log_error() {
  echo -e "${RED}[${HOOK_NAME}]${NC} $1" >&2
}

# Get git information
get_git_info() {
  CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
  COMMIT_HASH=$(git rev-parse HEAD 2>/dev/null || echo "unknown")
  FILES_CHANGED=$(git diff --name-only HEAD~1 HEAD 2>/dev/null | wc -l | tr -d ' ')
  MERGE_TYPE=$( [ "$SQUASH_MERGE" -eq 1 ] && echo "squash" || echo "normal" )

  log_info "Branch: $CURRENT_BRANCH"
  log_info "Commit: $COMMIT_HASH"
  log_info "Type: $MERGE_TYPE merge"
  log_info "Files changed: $FILES_CHANGED"
}

# Main execution
main() {
  log_info "Post-merge hook starting..."

  # Get git information
  get_git_info

  # Check if GitVan CLI is available
  if ! command -v "$GITVAN_CLI" &> /dev/null; then
    log_warn "GitVan CLI not found, skipping knowledge hook evaluation"
    exit 0
  fi

  # Capture post-merge event and evaluate knowledge hooks
  log_info "Evaluating knowledge hooks..."

  # Create event data JSON
  EVENT_DATA=$(cat <<EOF
{
  "branchName": "$CURRENT_BRANCH",
  "commitHash": "$COMMIT_HASH",
  "filesChanged": $FILES_CHANGED,
  "mergeType": "$MERGE_TYPE",
  "squashMerge": $( [ "$SQUASH_MERGE" -eq 1 ] && echo "true" || echo "false" ),
  "timestamp": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
)

  # Call GitVan CLI to handle the event
  if ! echo "$EVENT_DATA" | "$GITVAN_CLI" hooks handle-event "$HOOK_NAME" --stdin; then
    log_warn "Knowledge hook evaluation failed (non-fatal)"
  fi

  log_info "Post-merge hook completed"
  exit 0
}

# Run main function
main "$@"
