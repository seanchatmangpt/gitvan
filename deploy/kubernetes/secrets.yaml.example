# Example secrets file - DO NOT COMMIT WITH REAL VALUES
# Copy to secrets.yaml and fill in real values
# Then apply: kubectl apply -f secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: gitvan-secrets
  namespace: gitvan
type: Opaque
stringData:
  # Anthropic API key for AI features
  anthropic-api-key: "YOUR_ANTHROPIC_API_KEY_HERE"

  # Ollama host (if using local AI)
  ollama-host: "http://ollama:11434"

  # Grafana admin credentials
  grafana-admin-user: "admin"
  grafana-admin-password: "CHANGE_ME"

  # Additional secrets as needed
  # github-token: "YOUR_GITHUB_TOKEN"
  # slack-webhook: "YOUR_SLACK_WEBHOOK"
